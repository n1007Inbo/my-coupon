{
  "kind": "collectionType",
  "collectionName": "coupons",
  "info": {
    "singularName": "coupon",
    "pluralName": "coupons",
    "displayName": "Coupon"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": false
    }
  },
  "attributes": {
    "code": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "discount": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "store": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::store.store",
      "inversedBy": "coupons"
    },
    "expiry_date": {
      "type": "datetime"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    }
  }
}
